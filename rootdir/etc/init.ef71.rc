
# Acdbdata
service vendor.acdbdata-sh /vendor/bin/init.acdbdata.sh
    class hal
    user system
    group system
    oneshot

on property:persist.vendor.audio.calfile0=*
    exec /bin/sleep 1s
    restart vendor.audio-hal

# Baseband
service vendor.baseband-sh /vendor/bin/init.baseband.sh
    class late_start
    user system
    group system
    oneshot
    disabled

# Camera & NFC data directories
on post-fs-data
    mkdir /data/vendor/qcam 0770 camera camera
    mkdir /data/vendor/nfc 0770 nfc nfc


on property:init.svc.vendor.qcamerasvr=running
    exec /bin/sleep 1s
    restart vendor.camera-provider-2-4

# Charger
on property:ro.bootmode=charger && property:init.svc.vendor.qcom-post-boot=stopped
    # Lock to lowest frequency on charger mode
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor powersave
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor powersave

    # Offline all cores except cpu0
    write /sys/devices/system/cpu/cpu1/online 0
    write /sys/devices/system/cpu/cpu2/online 0
    write /sys/devices/system/cpu/cpu3/online 0
    write /sys/devices/system/cpu/cpu4/online 0
    write /sys/devices/system/cpu/cpu5/online 0
    write /sys/devices/system/cpu/cpu6/online 0
    write /sys/devices/system/cpu/cpu7/online 0

# FM
on property:hw.fm.init=*
    write /sys/module/radio_iris_transport/parameters/fmsmd_set ${hw.fm.init}

# RIL. Single SIM: a second RIL grabs IQcRilAudio/slot1 and reports the
# wrong voice session, which leaves VoLTE calls silent; init.class_main.sh
# only starts vendor.qcrild2 for multi-SIM configurations.
on boot
    enable vendor.qcrild

on property:vendor.subsys_state_notifier.modem.state=OFFLINE
    stop vendor.qcrild

on property:vendor.subsys_state_notifier.modem.state=ONLINE
    start vendor.qcrild

# SDHCI
on early-fs
    write /sys/kernel/sdhci_msm/add_host 1
    wait /dev/block/platform/soc/7824900.sdhci/by-name/modem

on boot && property:ro.boot.bootdevice=7864900.sdhci
    symlink /dev/block/platform/soc/7824900.sdhci/by-name/modemst1 /dev/block/bootdevice/by-name/modemst1
    symlink /dev/block/platform/soc/7824900.sdhci/by-name/modemst2 /dev/block/bootdevice/by-name/modemst2
    symlink /dev/block/platform/soc/7824900.sdhci/by-name/fsc /dev/block/bootdevice/by-name/fsc
    symlink /dev/block/platform/soc/7824900.sdhci/by-name/fsg /dev/block/bootdevice/by-name/fsg

# Subsystem Restart
on init
    # Setup all the sub-system as related
    write /sys/bus/msm_subsys/devices/subsys0/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys1/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys2/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys3/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys4/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys5/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys6/restart_level RELATED

# Time
on property:sys.boot_completed=1
    restart time_daemon

# Wi-Fi
on init
    chown wifi wifi /sys/module/wlan/parameters/fwpath

# Write caching
on property:ro.vendor.ef71.enable_write_caching=1
 # write caching
    # Tell the kernel to use up to 99% of the RAM as cache for writes
    # and instruct kernel to use up to 50% of RAM before slowing down
    # the process that's writing.
    write /proc/sys/vm/dirty_ratio 99
    write /proc/sys/vm/dirty_background_ratio 50

    # Tell that 10 minutes write delay is ok to even start writing
    # stuff on the disk (ten minutes = 60000; 1 hour 360000).
    write /proc/sys/vm/dirty_expire_centisecs 60000
    write /proc/sys/vm/dirty_writeback_centisecs 60000

# EF71 (Pantech) additions, from the LineageOS 17.1 init.qcom.rc

on post-fs
    # Korean carriers attach on the IMS APN (see init.ef71.apn.sh)
    mount none /vendor/etc/ef71_apns-conf.xml /product/etc/apns-conf.xml bind

on early-boot
    # LP5523 notification and key LEDs
    chown system system /sys/class/leds/red/brightness
    chown system system /sys/class/leds/red/blink
    chown system system /sys/class/leds/green/brightness
    chown system system /sys/class/leds/green/blink
    chown system system /sys/class/leds/blue/brightness
    chown system system /sys/class/leds/blue/blink
    chmod 0660 /sys/class/leds/lp5523:channel0/brightness
    chown system radio /sys/class/leds/lp5523:channel0/brightness
    chmod 0660 /sys/class/leds/lp5523:channel1/brightness
    chown system radio /sys/class/leds/lp5523:channel1/brightness
    chmod 0660 /sys/class/leds/lp5523:channel2/brightness
    chown system radio /sys/class/leds/lp5523:channel2/brightness
    chmod 0660 /sys/class/leds/lp5523:channel3/brightness
    chown system radio /sys/class/leds/lp5523:channel3/brightness
    chmod 0660 /sys/class/leds/lp5523:channel4/brightness
    chown system radio /sys/class/leds/lp5523:channel4/brightness
    chmod 0660 /sys/class/leds/lp5523:channel5/brightness
    chown system radio /sys/class/leds/lp5523:channel5/brightness
    chmod 0660 /sys/class/leds/lp5523:channel6/brightness
    chown system radio /sys/class/leds/lp5523:channel6/brightness
    chmod 0660 /sys/class/leds/lp5523:channel7/brightness
    chown system radio /sys/class/leds/lp5523:channel7/brightness
    chmod 0660 /sys/class/leds/lp5523:channel8/brightness
    chown system radio /sys/class/leds/lp5523:channel8/brightness
    chmod 0660 /dev/led_fops
    chown system radio /dev/led_fops

# SIM provisioning: modem EFS set for VoLTE, attach and internet APN profiles
on property:sys.boot_completed=1
    start vendor.ef71-apn

# LG U+ USIMs carry a CSIM app that never gets ready now that the carrier has no
# CDMA, and Android keeps such a card NOT_READY when the CDMA feature is on.
# init.ef71.apn.sh records the SIM type; this applies before system_server starts.
on property:persist.vendor.ef71.hide_cdma=1
    mount none /vendor/etc/ef71_nocdma.xml /vendor/etc/permissions/android.hardware.telephony.cdma.xml bind

# init.ef71.apn.sh changed something for a new SIM that is only read at boot
on property:vendor.ef71.sim_reboot=1
    setprop sys.powerctl reboot,ef71-sim

service vendor.ef71-apn /vendor/bin/init.ef71.apn.sh
    class late_start
    user radio
    group radio vendor_qti_diag
    disabled
    oneshot

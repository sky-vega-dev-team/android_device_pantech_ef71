# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# EF71: no vendor partition, the vendor tree lives in /system/vendor.
# oem is left alone: Pantech data may live there.

#<src>                                                  <mnt_point>             <type>  <mnt_flags and options>                                                         <fs_mgr_flags>
/dev/block/by-name/system                               /system                 ext4    ro,barrier=1                                                                    wait,first_stage_mount
/dev/block/by-name/boot                                 /boot                   emmc    defaults                                                                        defaults
/dev/block/by-name/recovery                             /recovery               emmc    defaults                                                                        defaults
/dev/block/by-name/misc                                 /misc                   emmc    defaults                                                                        defaults
/dev/block/by-name/config                               /frp                    emmc    defaults                                                                        defaults
/dev/block/by-name/cache                                /cache                  f2fs    nosuid,nodev,noatime,inline_xattr,flush_merge,data_flush                        wait,formattable,check
/dev/block/by-name/cache                                /cache                  ext4    nosuid,nodev,noatime                                                            wait,formattable,check
/dev/block/by-name/userdata                             /data                   f2fs    nosuid,nodev,noatime,inline_xattr,data_flush                                    latemount,wait,check,formattable,encryptable=footer,length=-16384
/dev/block/by-name/userdata                             /data                   ext4    nosuid,nodev,noatime,noauto_da_alloc                                            latemount,wait,check,formattable,encryptable=footer,length=-16384
/dev/block/by-name/persist                              /mnt/vendor/persist     ext4    nosuid,nodev,noatime,no_sehash_xattr                                            wait,check
/dev/block/by-name/dsp                                  /vendor/dsp             ext4    ro,nosuid,nodev                                                                 wait
/dev/block/by-name/modem                                /vendor/firmware_mnt    vfat    ro,context=u:object_r:firmware_file:s0,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337 wait
/devices/platform/soc/7864900.sdhci/mmc_host*           auto                    auto    defaults                                                                        wait,voldmanaged=sdcard1:auto,noemulatedsd,encryptable=userdata
/devices/platform/soc/78db000.usb/msm_hsusb_host*       auto                    auto    defaults                                                                        wait,voldmanaged=usb:auto

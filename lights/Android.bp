cc_binary {
    name: "android.hardware.lights-service.ef71",
    relative_install_path: "hw",
    init_rc: ["android.hardware.lights-service.ef71.rc"],
    vintf_fragments: ["android.hardware.lights-service.ef71.xml"],
    vendor: true,
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.light-V1-ndk_platform",
    ],
    srcs: [
        "Lights.cpp",
        "main.cpp",
    ],
}

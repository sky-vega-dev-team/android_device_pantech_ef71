service charger_led /system/bin/charger_led
    user system
    group system
    file /dev/kmsg w
    seclabel u:r:charger_led:s0
    oneshot

on early-init
    chown system system /sys/class/leds/lp5523:channel0/brightness
    chown system system /sys/class/leds/lp5523:channel1/brightness
    chown system system /sys/class/leds/lp5523:channel2/brightness
    chown system system /sys/class/leds/lp5523:channel3/brightness
    chown system system /sys/class/leds/lp5523:channel6/brightness
    chown system system /sys/class/leds/lp5523:channel7/brightness
    chown system system /sys/class/leds/lp5523:channel8/brightness

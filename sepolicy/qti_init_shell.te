allow qti_init_shell sysfs:file { rw_file_perms };

# init.ef71.apn.sh sets the device up for the inserted SIM
set_prop(qti_init_shell, ef71_sim_prop)
domain_auto_trans(qti_init_shell, ef71_modemcfg_exec, ef71_modemcfg)
allow qti_init_shell vendor_radio_data_file:dir rw_dir_perms;
allow qti_init_shell vendor_radio_data_file:file create_file_perms;

# init.qcom.post_boot.sh: CPU, devfreq and scheduler tuning, then the perf
# HAL may take perf locks
allow qti_init_shell sysfs_devices_system_cpu:dir r_dir_perms;
allow qti_init_shell sysfs_devices_system_cpu:file rw_file_perms;
allow qti_init_shell sysfs_devfreq:dir r_dir_perms;
allow qti_init_shell sysfs_devfreq:file rw_file_perms;
set_prop(qti_init_shell, vendor_mpctl_prop)

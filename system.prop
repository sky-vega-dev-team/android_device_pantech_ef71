#
# system.prop for Pantech EF71
#
# msm8937 base (system, system_ext and radio), then the EF71 values
#

sdm.debug.disable_skip_validate=1
persist.hwc.mdpcomp.enable=true
persist.demo.hdmirotationlock=false
media.msm8956hw=0
mm.enable.smoothstreaming=true
mmp.enable.3g2=true
media.aac_51_output_enabled=true
media.settings.xml=/vendor/etc/media_profiles_vendor.xml
audio.offload.min.duration.secs=30
audio.offload.video=true
audio.deep_buffer.media=true
ro.af.client_heap_size_kbyte=7168
af.fast_track_multiplier=1
vendor.mm.enable.qcom_parser=4194303
media.stagefright.thumbnail.prefer_hw_codecs=true
persist.mm.sta.enable=0
persist.timed.enable=true
ro.qualcomm.svi=1
ro.qualcomm.cabl=2
ro.qcom.svi.sensortype=2
config.svi.xml=1
config.svi.path=vendor/data/sviconfig.xml
ro.fm.transmitter=false
persist.debug.wfd.enable=1
persist.hwc.enable_vds=1
persist.debug.coresight.config=stm-events
persist.console.silent.config=1
persist.qfp=false
ro.hwui.texture_cache_size=72
ro.hwui.layer_cache_size=48
ro.hwui.r_buffer_cache_size=8
ro.hwui.path_cache_size=32
ro.hwui.gradient_cache_size=1
ro.hwui.drop_shadow_cache_size=6
ro.hwui.texture_cache_flushrate=0.4
ro.hwui.text_small_cache_width=1024
ro.hwui.text_small_cache_height=1024
ro.hwui.text_large_cache_width=2048
ro.hwui.text_large_cache_height=2048
ro.cutoff_voltage_mv=3400
persist.omacp.enable=true
persist.mmssupportcp.enable=true
ro.vendor.qti.va_aosp.support=1
ro.bluetooth.a2dp_offload.supported=false
ro.charger.disable_init_blank=true
ro.fastbootd.available=true
debug.renderengine.backend=threaded
persist.sys.binary_xml=false
persist.vendor.dpm.feature=11
rild.libpath=/vendor/lib64/libril-qc-qmi-1.so
rild.libargs=-d /dev/smd0
persist.rild.nitz_plmn=
persist.rild.nitz_long_ons_0=
persist.rild.nitz_long_ons_1=
persist.rild.nitz_long_ons_2=
persist.rild.nitz_long_ons_3=
persist.rild.nitz_short_ons_0=
persist.rild.nitz_short_ons_1=
persist.rild.nitz_short_ons_2=
persist.rild.nitz_short_ons_3=
DEVICE_PROVISIONED=1
persist.data.netmgrd.qos.enable=true
persist.radio.DROPSETENABLE=1
persist.data.profile_update=true
persist.radio.force_on_dc=true
persist.rcs.supported=1
persist.function_for_sar=1
persist.function_for_sar_log_trigger=0
persist.radio.sarvalue=-1

# EF71
ro.config.media_vol_steps=20
ro.config.vc_call_vol_steps=8
ro.telephony.default_network=10
telephony.lteOnCdmaDevice=1
ril.subscription.types=NV,RUIM
ro.telephony.call_ring.multiple=false
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=0
persist.dbg.ims_volte_enable=1
persist.radio.multisim.config=none
ro.nfc.port=I2C
ro.device.chipset=Qualcomm MSM8937 Snapdragon 430
ro.device.cpu=Octa-core 1.4 GHz Cortex-A53
ro.device.gpu=Adreno 505
ro.device.rear_cam=13MP
ro.device.front_cam=5MP
ro.device.screen_res=1080 x 1920

